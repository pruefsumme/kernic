{
	"name": "@kernic/worker",
	"private": true,
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"description": "Isolated Typst compile worker. Holds no application secrets and no database access.",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
		"start": "node src/main.ts",
		"check": "tsc --noEmit",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "node --test 'test/*.test.ts'"
	},
	"devDependencies": {
		"@types/node": "^24",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3"
	}
}
