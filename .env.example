# Copy to .env for local development (`pnpm dev`). See docs/development.md.

# PostgreSQL from compose.dev.yaml
DATABASE_URL=postgres://kernic:kernic@127.0.0.1:54329/kernic

# Where project files and rendered artifacts are stored.
KERNIC_DATA_DIR=./data

# Typst compile worker. The token only authenticates the app to the worker.
KERNIC_WORKER_URL=http://127.0.0.1:3101
KERNIC_WORKER_TOKEN=dev-only-worker-token-change-me

# Optional: fixed token for the first-run setup page. If unset, one is generated
# at startup and printed to the server log.
# KERNIC_SETUP_TOKEN=

# Optional: Typst package registry, or "off" to disable package downloads.
# KERNIC_PACKAGE_REGISTRY=https://packages.typst.org

# Optional: how compiles are confined, "bwrap" (default) or "landlock". Jumps between
# page and source need "landlock"; the readme says what that means outside Docker.
# KERNIC_WORKER_SANDBOX=bwrap
