{
	"name": "kernic",
	"private": true,
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"description": "Self-hosted, Git-first Typst authoring workspace",
	"packageManager": "pnpm@11.28.4",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --parallel --filter @kernic/web --filter @kernic/worker dev",
		"dev:web": "pnpm --filter @kernic/web dev",
		"dev:worker": "pnpm --filter @kernic/worker dev",
		"build": "pnpm --filter @kernic/web build",
		"check": "pnpm -r check",
		"lint": "pnpm -r lint",
		"test": "pnpm -r test",
		"test:e2e": "pnpm --filter @kernic/web test:e2e",
		"test:durability": "pnpm --filter @kernic/web test:durability",
		"test:migrations": "pnpm --filter @kernic/web test:migrations"
	}
}
