# Copy to deploy/.env and fill in. Never commit the copy.

# Where Kernic is reachable.
#   kernic.example.org   a domain pointing at this server: HTTPS with an automatic certificate
#   localhost            this machine only, HTTPS with a locally trusted certificate
#   :80                  plain HTTP on every address (only behind another TLS proxy or on a trusted LAN)
KERNIC_SITE_ADDRESS=kernic.example.org

# Host ports the proxy listens on.
KERNIC_HTTP_PORT=80
KERNIC_HTTPS_PORT=443

# Generate each of these with:  openssl rand -hex 32
POSTGRES_PASSWORD=
KERNIC_WORKER_TOKEN=

# Optional. If empty, a setup token is generated and printed by `docker compose logs app`
# on first start.
KERNIC_SETUP_TOKEN=

# Where Typst packages (#import "@preview/...") are downloaded from. Use a mirror's URL, or
# "off" to disable downloads.
KERNIC_PACKAGE_REGISTRY=https://packages.typst.org

# Limits (megabytes / count). Raise BODY_SIZE_LIMIT in compose.yaml along with the project size.
KERNIC_MAX_FILE_MB=25
KERNIC_MAX_PROJECT_MB=200
KERNIC_MAX_PROJECT_FILES=2000

# Compile worker resources.
KERNIC_WORKER_CPUS=2
KERNIC_WORKER_MEMORY=4g
KERNIC_COMPILE_TIMEOUT_MS=20000
# Projects that keep a compiler running between preview compiles (faster preview,
# up to about 1 GB of worker memory each). 0 turns this off.
KERNIC_WARM_SESSIONS=2
