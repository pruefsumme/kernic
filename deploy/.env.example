# Copy to deploy/.env and fill in. Never commit the copy.

# Where Kernic is reachable.
#   kernic.example.org   a domain pointing at this server: HTTPS with an automatic certificate
#   localhost            this machine only, HTTPS with a locally trusted certificate
#   :80                  plain HTTP on every address (only behind another TLS proxy or on a trusted LAN)
KERNIC_SITE_ADDRESS=kernic.example.org

# Host ports the proxy listens on.
KERNIC_HTTP_PORT=80
KERNIC_HTTPS_PORT=443

# Generate each of these with:  openssl rand -hex 32
POSTGRES_PASSWORD=
KERNIC_WORKER_TOKEN=

# Optional: run the images a release published (see docs/self-hosting.md) instead of building
# them here. Use the same version for both. Leave empty to build from the source.
KERNIC_APP_IMAGE=
KERNIC_WORKER_IMAGE=

# Optional. If empty, a setup token is generated and printed by `docker compose logs app`
# on first start.
KERNIC_SETUP_TOKEN=

# Where Typst packages (#import "@preview/...") are downloaded from. Use a mirror's URL, or
# "off" to disable downloads.
KERNIC_PACKAGE_REGISTRY=https://packages.typst.org

# Limits (megabytes / count). Raise BODY_SIZE_LIMIT in compose.yaml along with the project size.
KERNIC_MAX_FILE_MB=25
KERNIC_MAX_PROJECT_MB=200
KERNIC_MAX_PROJECT_FILES=2000
# What one workspace (each person has one of their own) may use of the server:
# megabytes of project files in total, and number of projects.
KERNIC_MAX_WORKSPACE_MB=2000
KERNIC_MAX_WORKSPACE_PROJECTS=200
# Most compiles one account may have waiting or running at once.
KERNIC_MAX_WAITING_COMPILES=20

# Git forges (Forgejo, Gitea, ...) that projects may push their checkpoints to: host names,
# separated by commas. The server connects only to these. Write http:// in front of a host
# that is only reachable without TLS, such as a forge on the same private network.
# Leave empty to turn this off.
KERNIC_GIT_HOSTS=
# Encrypts the access tokens people enter for their repositories. Required when
# KERNIC_GIT_HOSTS is set: `openssl rand -hex 32`. Keep it with your backups; without it
# the tokens cannot be read and have to be entered again.
KERNIC_SECRET_KEY=

# Backups (deploy/backup.sh, docs/backups.md). How many dated folders to keep in the backup
# directory on this machine; the oldest are removed after each run. 0 keeps all.
KERNIC_BACKUP_KEEP_LOCAL=7

# Off-site backups: where to send them, encrypted, after each run. Leave empty to keep them on
# this machine only (not safe against losing it). One of:
#   s3:https://s3.us-west-004.backblazeb2.com/my-bucket/kernic   Backblaze B2, Cloudflare R2,
#                                                                 Wasabi, Amazon S3 (set the three
#                                                                 KERNIC_BACKUP_S3_* below)
#   sftp://u123456@u123456.your-storagebox.de:23/kernic            a server over SSH, such as a
#                                                                 Hetzner Storage Box (key in the
#                                                                 settings folder)
#   rclone:gdrive:kernic                                          Google Drive, Dropbox, OneDrive,
#                                                                 Nextcloud ... through rclone
#                                                                 (./backup-tool.sh rclone config)
#   /repo                                                         another disk (KERNIC_BACKUP_LOCAL_REPO)
KERNIC_BACKUP_REPOSITORY=
# Encrypts everything that is sent: `openssl rand -hex 24`. KEEP A COPY OF IT OUTSIDE THIS
# SERVER (a password manager): without it the off-site backups cannot be read by anyone.
KERNIC_BACKUP_PASSWORD=
# For an s3: repository.
KERNIC_BACKUP_S3_KEY_ID=
KERNIC_BACKUP_S3_SECRET=
KERNIC_BACKUP_S3_REGION=
# Settings of the destination (rclone's login, the SSH key as ssh/id_ed25519 with
# ssh/known_hosts) and restic's cache. Default: ./backup-config
# KERNIC_BACKUP_CONFIG_DIR=./backup-config
# A repository on another disk or mount of this machine, for KERNIC_BACKUP_REPOSITORY=/repo.
# KERNIC_BACKUP_LOCAL_REPO=/mnt/backup-disk/kernic
# How many snapshots stay in the repository: the newest of each of the last days, weeks, months.
KERNIC_BACKUP_KEEP_DAILY=7
KERNIC_BACKUP_KEEP_WEEKLY=4
KERNIC_BACKUP_KEEP_MONTHLY=6
# Addresses of a monitor (Healthchecks.io, Uptime Kuma, ...) that raises the alarm when a
# backup, or a check of the backups, did not report in time. Optional.
KERNIC_BACKUP_PING_URL=
KERNIC_BACKUP_VERIFY_PING_URL=

# Compile worker resources.
KERNIC_WORKER_CPUS=2
KERNIC_WORKER_MEMORY=4g
KERNIC_COMPILE_TIMEOUT_MS=20000
# Projects that keep a compiler running between preview compiles (faster preview,
# up to about 1 GB of worker memory each). 0 turns this off.
KERNIC_WARM_SESSIONS=2
# Editors that get completion, documentation and navigation from a language
# server at the same time (roughly 100 to 300 MB of worker memory each). 0 turns this off.
KERNIC_LANGUAGE_SESSIONS=4
